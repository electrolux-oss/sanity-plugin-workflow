{
  "name": "@electrolux-oss/sanity-plugin-workflow",
  "version": "5.0.1",
  "keywords": [
    "electrolux",
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/electrolux-oss/sanity-plugin-workflow",
  "license": "MIT",
  "author": "Tommy Ljungberg",
  "contributors": [
    {
      "name": "Philip Åkerfeldt",
      "url": "https://www.npmjs.com/~philip.akerfeldt"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrolux-oss/sanity-plugin-workflow.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.9",
    "@tanstack/react-virtual": "^3.14.9",
    "lexorank": "^1.0.5",
    "sanity-plugin-utils": "^2.0.22"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "groq-js": "^2.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.1.3",
    "sanity": "^6.21.0",
    "styled-components": "^6.1.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.20.0",
    "styled-components": "^6.1.15"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "nodeEngine": false,
      "scripts": false
    }
  }
}
