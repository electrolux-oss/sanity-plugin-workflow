{
  "name": "@electrolux-oss/sanity-plugin-workflow",
  "version": "5.0.1",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "electrolux"
  ],
  "homepage": "https://github.com/electrolux-oss/sanity-plugin-workflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrolux-oss/sanity-plugin-workflow.git"
  },
  "license": "MIT",
  "author": "Tommy Ljungberg",
  "contributors": [
    {
      "name": "Philip Åkerfeldt",
      "url": "https://www.npmjs.com/~philip.akerfeldt"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "watch": "pkg-utils watch --strict",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.9",
    "@tanstack/react-virtual": "^3.14.9",
    "lexorank": "^1.0.5",
    "sanity-plugin-utils": "^2.0.22"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^10.9.2",
    "@sanity/plugin-kit": "^6.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-sanity": "^6.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "groq-js": "^2.0.0",
    "prettier": "^2.8.4",
    "prettier-plugin-packagejson": "^2.5.20",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.1.3",
    "sanity": "^6.21.0",
    "styled-components": "^6.1.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.20.0",
    "styled-components": "^6.1.15"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
